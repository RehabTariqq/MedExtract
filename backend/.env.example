MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=medextract

# LLM (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Embeddings (https://dashboard.cohere.com)
COHERE_API_KEY=

# Auth
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Vector DB: for local Docker leave QDRANT_URL empty; for Qdrant Cloud fill both
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,https://medextract-frontend.onrender.com
